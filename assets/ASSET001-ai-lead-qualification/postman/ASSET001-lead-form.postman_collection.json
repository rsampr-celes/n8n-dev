{
  "info": {
    "_postman_id": "f2fb1e2d-2bb1-4c50-8243-71141125bd7d",
    "name": "ASSET001 - Website Lead Form",
    "description": "Tests the published ASSET001 n8n Form Trigger. Requests use multipart/form-data and a browser-like User-Agent because the trigger's Ignore Bots option rejects Postman's default User-Agent. A 200 response means the form was accepted; inspect the n8n execution to confirm the workflow branch.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const configuredBaseUrl = pm.variables.replaceIn('{{baseUrl}}');",
          "pm.variables.set('resolvedBaseUrl', configuredBaseUrl.replace(/\\/+$/, ''));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5681",
      "type": "string"
    },
    {
      "key": "formPath",
      "value": "/form/asset001-lead-qualification",
      "type": "string"
    },
    {
      "key": "resolvedBaseUrl",
      "value": "http://localhost:5681",
      "type": "string"
    },
    {
      "key": "idempotencyEmail",
      "value": "postman.idempotency@example.test",
      "type": "string"
    },
    {
      "key": "idempotencyPhone",
      "value": "+15550102130",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Create New Idempotency Claim",
      "description": "Generates a unique email before sending. With idempotency enabled, this should create a new processing claim and continue qualification.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now();",
              "pm.collectionVariables.set('idempotencyEmail', `postman.idempotency.${runId}@example.test`);",
              "console.log(`Idempotency test email: ${pm.collectionVariables.get('idempotencyEmail')}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Form endpoint returns HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('n8n accepted the form submission', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response.status).to.eql(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "User-Agent",
            "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36",
            "type": "text"
          }
        ],
