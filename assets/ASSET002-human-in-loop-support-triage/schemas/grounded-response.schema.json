{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://celes7a.example/schemas/asset002-grounded-response.schema.json",
  "title": "ASSET002 grounded response",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposed_response", "source_ids", "confidence", "recommended_agent_action", "warnings"],
  "properties": {
    "proposed_response": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "source_ids": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "recommended_agent_action": { "type": "string", "enum": ["approve", "edit_and_approve", "request_more_information", "manual_response"] },
    "warnings": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } }
  }
}
