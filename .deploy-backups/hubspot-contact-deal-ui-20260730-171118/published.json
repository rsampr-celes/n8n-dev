      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const crmRequest = $('Build HubSpot CRM Request').first().json;\nconst candidates = $input.all()\n  .filter((item) => item.json?.id !== undefined && item.json?.id !== null)\n  .map((item) => String(item.json.id));\n\nlet dealMatch;\nif (candidates.length === 0) {\n  dealMatch = {\n    action: 'create',\n    deal_id: null,\n    match_count: 0,\n    candidate_deal_ids: [],\n    review_reason: null,\n  };\n} else if (candidates.length === 1) {\n  dealMatch = {\n    action: 'update',\n    deal_id: candidates[0],\n    match_count: 1,\n    candidate_deal_ids: candidates,\n    review_reason: null,\n  };\n} else {\n  dealMatch = {\n    action: 'review',\n    deal_id: null,\n    match_count: candidates.length,\n    candidate_deal_ids: candidates,\n    review_reason: 'multiple_deals_for_correlation_id',\n  };\n}\n\nreturn [{\n  json: {\n    crm_request: crmRequest,\n    deal_match: dealMatch,\n    should_write: dealMatch.action !== 'review',\n  },\n}];\n"
