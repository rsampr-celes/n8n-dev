on ?? {};\nconst messages = Array.isArray(response.payload) ? response.payload : [];\nconst currentMessageId = prepared.support_event.message_id;\n\nconst conversationContext = messages\n  .filter((message) => message && message.private !== true && String(message.id ?? '') !== currentMessageId)\n  .filter((message) => message.message_type === 0 || message.message_type === 1 || message.message_type === 'incoming' || message.message_type === 'outgoing')\n  .slice(-10)\n  .map((message) => ({\n    role: message.message_type === 1 || message.message_type === 'outgoing' ? 'agent' : 'customer',\n    content: typeof message.content === 'string'\n      ? message.content.replace(/\\u0000/g, '').replace(/\\r\\n?/g, '\\n').trim().slice(0, 2000)\n      : '',\n  }))\n  .filter((message) => message.content);\n\nreturn [{ json: { support_event: prepared.support_event, conversation_context: conversationContext } }];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1560,40],"id":"asset002-prepare-context","name":"Prepare Conversation Context"},{"parameters":{"source":"database","workflowId":{"__rl":true,"value":"ASSET002AITriage01","mode":"id"},"workflowInputs":{"mappingMode":"defineBelow","value":{"support_event":"={{ $json.support_event }}","conversation_context":"={{ $json.conversation_context }}"},"matchingColumns":[],"schema":[{"id":"support_event","displayName":"support_event","required":true,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"object"},{"id":"conversation_context","displayName":"conversation_context","required":true,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"array"}],"attemptToConvertTypes":false,"convertFieldsToString":false},"mode":"once","options":{"waitForSubWorkflow":true}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[1820,40],"id":"asset002-execute-triage","name":"Execute AI Triage"},{"parameters":{"source":"database","workflowId":{"__rl":true,"value":"ASSET002ResponsePreparation01","mode":"id"},"workflowInputs":{"mappingMode":"defineBelow","value":{"support_event":"={{ $('Prepare Conversation Context').first().json.support_event }}","triage":"={{ $json.triage }}","conversation_context":"={{ $('Prepare Conversation Context').first().json.conversation_context }}"},"matchingColumns":[],"schema":[{"id":"support_event","displayName":"support_event","required":true,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"object"},{"id":"triage","displayName":"triage","required":true,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"object"},{"id":"conversation_context","displayName":"conversation_context","required":true,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"array"}],"attemptToConvertTypes":false,"convertFieldsToString":false},"mode":"once","options":{"waitForSubWorkflow":true}},"type":"n8n-nodes-base.executeWorkflow","typeVersion":1.3,"position":[2080,40],"id":"asset002-execute-response","name":"Execute Response Preparation"},{"parameters":{"mode":"runOnceForAllItems","jsCode":"const prepared = $('Execute Prepare Message').first().json;\nconst triage = $('Execute AI Triage').first().json.triage;\nconst preparation = $input.first().json.response_preparation;\nconst lines = [\n  'AI support triage — internal review only',\n  `Correlation: ${prepared.correlation_id}`,\n  `Category: ${triage.category}`,\n  `Intent: ${triage.intent}`,\n  `Urgency: ${triage.urgency}`,\n  `Sentiment: ${triage.sentiment}`,\n  `Assigned team: ${triage.assigned_team}`,\n  `Triage confidence: ${triage.confidence}`,\n  `Route: ${triage.route}`,\n  `Reasons: ${triage.reason_codes.join(', ')}`,\n  `Summary: ${triage.summary}`,\n  '',\n  preparation.status === 'draft_ready' ? 'Proposed response:' : 'No response draft was produced. Manual handling is required.',\n  preparation.proposed_response ?? '',\n  preparation.sources.length ? `Sources: ${preparation.sources.map((source) => `${source.knowledge_id} — ${source.title}`).join('; ')}` : 'Sources: none',\n  `Response confidence: ${preparation.confidence}`,\n  `Recommended action: ${preparation.recommended_agent_action}`,\n  'An authorised agent must review and send any customer-facing response.',\n];\n\nreturn [{ json: {\n  account_id: prepared.support_event.account_id,\n  conversation_id: prepared.support_event.conversation_id,\n  correlation_id: prepared.correlation_id,\n  triage,\n  response_preparation: preparation,\n  chatwoot_request: { content: lines.filter((line, index) => line || index > 0).join('\\n').slice(0, 12000), message_type: 'outgoing', private: true },\n} }];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2340,40],"id":"asset002-prepare-review-note","name":"Prepare Chatwoot Review Note"},{"parameters":{"method":"POST","url":"={{ $env.CHATWOOT_BASE_URL + '/api/v1/accounts/' + $json.account_id + '/conversations/' + $json.conversation_id + '/messages' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"api_access_token","value":"={{ $env.CHATWOOT_API_ACCESS_TOKEN }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify($json.chatwoot_request) }}","options":{"timeout":30000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[2600,40],"id":"asset002-create-private-note","name":"Create Chatwoot Private Note","notesInFlow":true,"notes":"Creates a private internal note only. This node never sends a public customer message.","onError":"stopWorkflow"},{"parameters":{},"type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1300,300],"id":"asset002-ignored-event","name":"Ignored Chatwoot Event"},{"parameters":{},"type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1300,500],"id":"asset002-invalid-event","name":"Invalid Event Rejected"}],"connections":{"Chatwoot Webhook":{"main":[[{"node":"Automation Webhook Authorized?","type":"main","index":0}]]},"Automation Webhook Authori